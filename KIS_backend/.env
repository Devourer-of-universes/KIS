# Сервер
PORT=3000
NODE_ENV=development

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corporate_messenger
DB_USER=messenger_user
DB_PASSWORD=mes123user

# JWT
JWT_SECRET=super-secret-jwt-key-change-this-in-production-2024
JWT_EXPIRE=7d

# WebSocket
WS_PORT=3001

# Файлы
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Администраторы (ID пользователей, которые имеют права админа)
ADMIN_IDS=1

# Время оффлайн для определения статуса (минуты)
OFFLINE_TIMEOUT_MINUTES=5

# Лимиты запросов
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100